{
  "name": "desktop-trampoline",
  "version": "0.9.12",
  "type": "commonjs",
  "main": "dist/index.js",
  "license": "MIT",
  "bin": {
    "desktop-trampoline": "build/Release/desktop-trampoline"
  },
  "scripts": {
    "build": "tsc",
    "install": "node-gyp rebuild && tsc",
    "lint": "prettier -c **/*.js **/*.md",
    "lint:fix": "prettier --write **/*.js **/*.md",
    "test": "tsc -p tsconfig.test.json && node script/test.mjs"
  },
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.9",
    "@types/split2": "4.2.3",
    "node-gyp": "^10.1.0",
    "node-test-github-reporter": "^1.2.0",
    "prettier": "^3.3.1",
    "split2": "^4.1.0",
    "tsx": "^4.10.5",
    "typescript": "7.0.2"
  },
  "binary": {
    "napi_versions": [
      4
    ]
  },
  "config": {
    "runtime": "napi",
    "target": 4
  }
}
